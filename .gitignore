.DS_Store
.env
.venv/
.venv-steerling/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Model and remote-compute state
.cache/
*.safetensors
*.bin
*.pt
*.pth
.modal/

# Runs are ignored until explicitly pulled and reviewed for archival.
runs/*
!runs/.gitkeep
experiments/*/runs/*
!experiments/*/runs/.gitkeep

# Large, reproducible exploration tensors stay local and on the Modal Volume.
exploration/runs/*/results/*/*/activations.npz
exploration/runs/*/results/*/*/activation_chunks/
exploration/runs/*/results/06-token-concepts-above-5pct-v2/*/token_concepts.jsonl
exploration/runs/*/results/06-token-concepts-above-5pct-v2/*/token_concepts_chunks/
